# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Flagsmith: Organisation Settings > API Keys (admin key, keep secret)
FLAGSMITH_ADMIN_KEY=
# Environment Settings > Keys > Client-side Environment Key
FLAGSMITH_ENVIRONMENT_KEY=
# Optional: the project id is read from the environment if left empty
FLAGSMITH_PROJECT_ID=
# Optional: server-side key for the traffic simulator (created automatically if empty)
FLAGSMITH_SERVER_KEY=
# Self-hosted Flagsmith only
# FLAGSMITH_API_URL=http://localhost:8000/api/v1
# FLAGSMITH_APP_URL=http://localhost:8000

# GitHub fine-grained PAT: Contents + Pull requests read/write on the target repo
GITHUB_TOKEN=
DEFAULT_REPO=aakashpawar49/flagpilot
DEFAULT_BASE_BRANCH=main
DEFAULT_APP_PATH=demo-app
