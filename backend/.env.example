# AI model: any OpenAI-compatible API. Default is Google Gemini's free tier.
# Free key (no card): https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
# Other free options, for example:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<model>:free
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=qwen2.5-coder:14b  LLM_API_KEY=ollama
# Optional backup provider, tried when every model above is overloaded or out of quota
LLM_BACKUP_BASE_URL=https://api.groq.com/openai/v1
LLM_BACKUP_MODEL=openai/gpt-oss-120b
LLM_BACKUP_API_KEY=
# Build the generated change on a clean clone before opening a PR (needs git and npm)
VERIFY_BUILD=true

# Flagsmith: Organisation Settings > API Keys (admin key, keep secret)
FLAGSMITH_ADMIN_KEY=
# Environment Settings > Keys > Client-side Environment Key
FLAGSMITH_ENVIRONMENT_KEY=
# Optional: the project id is read from the environment if left empty
FLAGSMITH_PROJECT_ID=
# Optional: server-side key for the traffic simulator (created automatically if empty)
FLAGSMITH_SERVER_KEY=
# Self-hosted Flagsmith only
# FLAGSMITH_API_URL=http://localhost:8000/api/v1
# FLAGSMITH_APP_URL=http://localhost:8000

# GitHub fine-grained PAT: Contents + Pull requests read/write on the target repo
GITHUB_TOKEN=
DEFAULT_REPO=aakashpawar49/flagpilot
DEFAULT_BASE_BRANCH=main
DEFAULT_APP_PATH=demo-app
